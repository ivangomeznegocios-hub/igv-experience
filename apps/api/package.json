{
  "name": "@igv/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy && wrangler deploy -c wrangler.mcp.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dev:mcp": "wrangler dev -c wrangler.mcp.jsonc --port 8788"
  },
  "dependencies": {
    "@igv/core": "workspace:*",
    "@igv/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "jose": "6.2.18",
    "zod": "4.6.7",
    "@anthropic-ai/sdk": "1.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261119.1",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
